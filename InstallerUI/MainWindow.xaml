<Window x:Class="InstallerUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InstallerUI.Controls"
        Title="Setup"
        Width="620" Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="{StaticResource Font.Regular}">

    <!--
        Colors/Typography/Buttons/CheckBox are merged into Application.Resources by
        InstallerBootstrapperApplication before this window is created (there is no
        App.xaml in this project - see Program.cs), so every {StaticResource}/
        {DynamicResource} used here and by every page resolves from there.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <!-- Banner -->
        <Border Grid.Row="0" ClipToBounds="True" Background="{DynamicResource Brush.Surface}">
            <Image x:Name="BannerImage" Stretch="UniformToFill" Margin="0,0,0,0" Source="/Assets/banner.png" />
        </Border>

        <!-- Header (logo + contextual page title), step indicator, and page content -->
        <Grid Grid.Row="1" Margin="24,16,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:StepIndicatorControl x:Name="StepIndicator" Grid.Row="1" Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,-12,0,12">
                <Image x:Name="LogoImage" Width="56" Height="56" Stretch="Uniform" Source="/Assets/logo.jpg" />
                <TextBlock x:Name="PageTitleText" Style="{StaticResource Text.PageHeading}" Margin="14,0,0,0" Text="title..." />
            </StackPanel>

            <ContentControl x:Name="PageHost" Grid.Row="2" />
        </Grid>

        <Separator Grid.Row="2" Margin="0,8,0,0" />

        <!-- Button bar -->
        <StackPanel x:Name="ButtonBar" Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
        </StackPanel>
    </Grid>
</Window>
