<local:BasePage x:Class="InstallerUI.Pages.InstalledPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:InstallerUI.Pages">
    <StackPanel>
        <TextBlock x:Name="MessageText"
                   Style="{StaticResource Text.Body}"
                   Foreground="{DynamicResource Brush.Status.Success}"
                   Text="The app was installed successfully" />

        <CheckBox x:Name="LaunchAppCheckBox"
                  Style="{StaticResource CheckBox.Default}"
                  Content="Open the app on finish"
                  Margin="0,18,0,0" />
    </StackPanel>
</local:BasePage>
