<local:BasePage x:Class="InstallerUI.Pages.EulaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:InstallerUI.Pages">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <RichTextBox x:Name="EulaText" Grid.Row="0"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     BorderBrush="{DynamicResource Brush.Border}"
                     BorderThickness="1"
                     Background="{DynamicResource Brush.Surface}" />

        <CheckBox x:Name="AcceptCheckBox" Grid.Row="1"
                  Style="{StaticResource CheckBox.Default}"
                  Content="Accept terms and conditions"
                  Margin="0,14,0,0"
                  Checked="OnAcceptChanged"
                  Unchecked="OnAcceptChanged" />
    </Grid>
</local:BasePage>
