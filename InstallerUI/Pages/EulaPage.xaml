<UserControl x:Class="InstallerUI.Pages.EulaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <RichTextBox x:Name="EulaText" Grid.Row="0"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     BorderBrush="#8A8A8A"
                     BorderThickness="1"
                     Background="White" />

        <CheckBox x:Name="AcceptCheckBox" Grid.Row="1"
                  Content="Accept terms and conditions"
                  Foreground="#595959"
                  Margin="0,12,0,0"
                  Checked="OnAcceptChanged"
                  Unchecked="OnAcceptChanged" />
    </Grid>
</UserControl>
