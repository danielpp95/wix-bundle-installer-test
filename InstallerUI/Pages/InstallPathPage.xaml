<local:BasePage x:Class="InstallerUI.Pages.InstallPathPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:InstallerUI.Pages">
    <StackPanel MinWidth="200">
        <TextBlock Text="Installation folder" Style="{StaticResource Text.Body}" Margin="0,0,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PathTextBox" Grid.Column="0"
                     Height="36"
                     VerticalContentAlignment="Center"
                     BorderBrush="{DynamicResource Brush.Border}"
                     Padding="8,0,0,0" />

            <Button x:Name="BrowseButton" Grid.Column="1"
                    Content="Browse"
                    Style="{StaticResource Button.Secondary}"
                    Click="OnBrowseClick" />
        </Grid>
    </StackPanel>
</local:BasePage>
