<UserControl x:Class="InstallerUI.Controls.LoaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MinWidth="200">
        <TextBlock x:Name="PercentageText"
                   FontFamily="{StaticResource Font.Black}"
                   FontSize="34"
                   Foreground="{DynamicResource Brush.Text.Primary}" />

        <Grid Height="6" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FillColumn" Width="0*" />
                <ColumnDefinition x:Name="RemainderColumn" Width="100*" />
            </Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="2" Background="{DynamicResource Brush.Track}" CornerRadius="3" />
            <Border x:Name="FillBar" Grid.Column="0" Background="{DynamicResource Brush.Action.Primary}" CornerRadius="3" />
        </Grid>

        <TextBlock x:Name="StatusTextBlock"
                   Style="{StaticResource Text.Caption}"
                   Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
