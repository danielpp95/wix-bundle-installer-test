<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>InstallerUI</AssemblyName>
    <RootNamespace>InstallerUI</RootNamespace>
    <!--
      Must stay x86. WiX v5's out-of-process bootstrapper application model ships a native
      pipe-connection shim (mbanative.dll, from the WixToolset.BootstrapperApplicationApi
      package) that is only built for x86, and Bundle1's Burn stub is x86 too. Building this
      project for AnyCPU/x64 does not fail at compile time - it fails at install time with
      "Failed to wait for bootstrapper application to connect to pipe" (0x80070080), or a
      COMException("Cannot change thread mode after it is set") if run standalone. Keep this
      in lockstep with whatever platform Bundle1.wixproj/Bundle.wxs targets.
    -->
    <Platforms>x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplicationApi" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\Package2\Assets\banner.png" Link="Assets\banner.png" />
    <Resource Include="..\Package2\Assets\logo.jpg" Link="Assets\logo.jpg" />
    <Resource Include="Assets\Eula.rtf" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Pages\BasePage.cs">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Compile>
  </ItemGroup>

</Project>
