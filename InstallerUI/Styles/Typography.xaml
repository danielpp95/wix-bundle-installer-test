<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        All four weights (Regular/Bold/Italic/BoldItalic) share the family name "Bosch Sans"
        in their own font tables, so WPF picks the right .ttf for FontWeight/FontStyle
        automatically - this one resource covers all of them. Light/Medium/Black are
        separate family names (distinct .ttf "weights" that aren't reachable via
        FontWeight on the regular family) so they get their own resources.
    -->
    <FontFamily x:Key="Font.Regular">pack://application:,,,/InstallerUI;component/Assets/fonts-ttf/#Bosch Sans</FontFamily>
    <FontFamily x:Key="Font.Light">pack://application:,,,/InstallerUI;component/Assets/fonts-ttf/#Bosch Sans Light</FontFamily>
    <FontFamily x:Key="Font.Medium">pack://application:,,,/InstallerUI;component/Assets/fonts-ttf/#Bosch Sans Medium</FontFamily>
    <FontFamily x:Key="Font.Black">pack://application:,,,/InstallerUI;component/Assets/fonts-ttf/#Bosch Sans Black</FontFamily>

    <Style x:Key="Text.PageHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

</ResourceDictionary>
