<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared chrome: both button styles are the same shape, only the fill/border/text
         relationship differs, so the visual states live in one template each and only the
         four "roles" (rest/hover/pressed/disabled) are re-pointed per style. -->

    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Light}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary: filled, for the one default/main action on a page (Next/Install/Finish). -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Action.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Action.PrimaryPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.PrimaryPressed}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Action.PrimaryPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.PrimaryPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.Border.Disabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Disabled}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary: outlined, for everything else (Cancel/Prev/Back). -->
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Action.Primary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Muted}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Muted}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.PrimaryPressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Action.PrimaryPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Disabled}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
