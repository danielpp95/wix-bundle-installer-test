<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Raw brand palette, verbatim from the Bosch color chart. Nothing outside this file
        should reference these directly (no "#007BC0" in a page) - they only exist so the
        semantic brushes below have a single, auditable source. If the palette changes,
        it changes here once.
    -->
    <Color x:Key="Palette.Red50">#ED0007</Color>
    <Color x:Key="Palette.Yellow85">#FFCF00</Color>
    <Color x:Key="Palette.Gray50">#71767C</Color>
    <Color x:Key="Palette.Green50">#00884A</Color>
    <Color x:Key="Palette.Turquoise50">#18837E</Color>
    <Color x:Key="Palette.Blue50">#007BC0</Color>
    <Color x:Key="Palette.Purple40">#9E2896</Color>

    <!-- Neutrals: not part of the supplied chart, chosen to sit alongside it. -->
    <Color x:Key="Palette.White">#FFFFFF</Color>
    <Color x:Key="Palette.Ink">#1A1A1A</Color>
    <Color x:Key="Palette.GrayLight">#D9DCDE</Color>
    <Color x:Key="Palette.GrayLighter">#F2F3F4</Color>

    <SolidColorBrush x:Key="Palette.Red50.Brush" Color="{StaticResource Palette.Red50}" />
    <SolidColorBrush x:Key="Palette.Yellow85.Brush" Color="{StaticResource Palette.Yellow85}" />
    <SolidColorBrush x:Key="Palette.Gray50.Brush" Color="{StaticResource Palette.Gray50}" />
    <SolidColorBrush x:Key="Palette.Green50.Brush" Color="{StaticResource Palette.Green50}" />
    <SolidColorBrush x:Key="Palette.Turquoise50.Brush" Color="{StaticResource Palette.Turquoise50}" />
    <SolidColorBrush x:Key="Palette.Blue50.Brush" Color="{StaticResource Palette.Blue50}" />
    <SolidColorBrush x:Key="Palette.Purple40.Brush" Color="{StaticResource Palette.Purple40}" />
    <SolidColorBrush x:Key="Palette.White.Brush" Color="{StaticResource Palette.White}" />
    <SolidColorBrush x:Key="Palette.Ink.Brush" Color="{StaticResource Palette.Ink}" />
    <SolidColorBrush x:Key="Palette.GrayLight.Brush" Color="{StaticResource Palette.GrayLight}" />
    <SolidColorBrush x:Key="Palette.GrayLighter.Brush" Color="{StaticResource Palette.GrayLighter}" />

    <!--
        Semantic brushes - what every page and style actually binds to. Naming describes
        the ROLE a color plays (Brush.Action.Primary), not which palette entry it happens
        to be today, so the palette can be re-themed without touching a single page.
    -->

    <!-- Primary action (filled buttons, checked states, active step). -->
    <SolidColorBrush x:Key="Brush.Action.Primary" Color="{StaticResource Palette.Blue50}" />
    <SolidColorBrush x:Key="Brush.Action.PrimaryPressed" Color="#005E93" />
    <SolidColorBrush x:Key="Brush.Action.OnPrimary" Color="{StaticResource Palette.White}" />

    <!-- Status colors. -->
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Palette.Green50}" />
    <SolidColorBrush x:Key="Brush.Status.Error" Color="{StaticResource Palette.Red50}" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Palette.Yellow85}" />

    <!-- Text. -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Palette.Ink}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Palette.Gray50}" />
    <SolidColorBrush x:Key="Brush.Text.OnPrimary" Color="{StaticResource Palette.White}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Palette.GrayLight}" />

    <!-- Surfaces and structure. -->
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Palette.White}" />
    <SolidColorBrush x:Key="Brush.Surface.Muted" Color="{StaticResource Palette.GrayLighter}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Palette.GrayLight}" />
    <SolidColorBrush x:Key="Brush.Border.Disabled" Color="{StaticResource Palette.GrayLighter}" />
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Palette.GrayLight}" />

</ResourceDictionary>
